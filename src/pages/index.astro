---
import Base from '../layouts/Base.astro';
import { profile, hero, atAGlance, explore, work, projects, volunteering, focusAreas } from '../data/site';
---

<Base title={profile.name}>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">{profile.role}</p>
      <h1>{hero.before} <i>{hero.emphasis}</i></h1>
      <p class="lede">{profile.tagline}</p>
      <div class="hero-actions">
        <a class="btn" href="#work">See the work</a>
        <a class="btn ghost" href={profile.linkedin}>LinkedIn ↗</a>
      </div>
    </div>
    <dl class="glance" aria-label="At a glance">
      <p class="eyebrow">At a glance</p>
      {atAGlance.map((g) => <div><dt>{g.label}</dt><dd>{g.value}</dd></div>)}
    </dl>
  </section>

  <section class="band explore">
    <p class="eyebrow">Explore</p>
    <h2>Work &amp; writing</h2>
    <div class="tiles">
      {explore.map((e) => (
        <a class="tile" href={e.href}>
          <strong>{e.label}</strong>
          <small>{e.blurb}</small>
        </a>
      ))}
    </div>
  </section>

  <section id="work" class="band">
    <p class="eyebrow">Platform work</p>
    <h2>What I build</h2>
    <div class="work-list">
      {work.map((w) => (
        <article class="work-item">
          <div>
            <h3>{w.title}</h3>
            <p>{w.blurb}</p>
            <div class="tags">{w.tags.map((t) => <span>{t}</span>)}</div>
          </div>
          <dl class="facts">
            {w.facts.map((f) => <div><dt>{f.value}</dt><dd>{f.label}</dd></div>)}
          </dl>
        </article>
      ))}
    </div>
  </section>

  <section id="projects" class="band">
    <p class="eyebrow">Projects</p>
    <h2>Things I’m building</h2>
    <div class="cards">
      {projects.map((p) => (
        <a class="card" href={`/projects/${p.slug}/`}>
          <span class="status">{p.status}</span>
          <h3>{p.title}</h3>
          <p>{p.blurb}</p>
          <div class="tags">{p.tags.map((t) => <span>{t}</span>)}</div>
        </a>
      ))}
    </div>
  </section>

  <section id="volunteering" class="band split">
    <div>
      <p class="eyebrow">Volunteering</p>
      <h2>Beyond the platform</h2>
    </div>
    <div>
      <p>{volunteering.body}</p>
      <a class="text-link" href={volunteering.url}>{volunteering.org} ↗</a>
    </div>
  </section>

  <section class="band split">
    <div>
      <p class="eyebrow">Where I’m headed</p>
      <h2>Focus areas</h2>
    </div>
    <ul class="focus">{focusAreas.map((f) => <li>{f}</li>)}</ul>
  </section>

  <section id="contact" class="band contact">
    <p class="eyebrow">Contact</p>
    <h2>Let’s talk</h2>
    <p>Open to Director and VP roles in Data &amp; AI platform leadership.</p>
    <p class="contact-row">
      <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}</a>
      <a href={profile.linkedin}>LinkedIn ↗</a>
      <span>{profile.location}</span>
    </p>
  </section>
</Base>
