---
import '../styles/global.css';
import { profile } from '../data/site';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
}

const { title, description = profile.tagline, canonicalPath = Astro.url.pathname } = Astro.props;
const pageTitle = title === profile.name ? title : `${title} — ${profile.name}`;
const canonicalUrl = new URL(canonicalPath, profile.siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
      <a class="nav-brand" href="/">{profile.name}</a>
        <div class="nav-links">
          <a href="/#projects">Projects</a>
          <a href="/#stack">Stack</a>
          <a href="/#contact">Contact</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        © {new Date().getFullYear()} {profile.name} · Built with Astro ·
        <a href={profile.linkedin}>LinkedIn</a> · <a href={profile.github}>GitHub</a>
      </p>
    </footer>
  </body>
</html>
